{
  "schema_version": 4,
  "runtime_id": "opencode",
  "identity_tokens": [
    "opencode"
  ],
  "notes_path": "docs/opencode-adapter-notes.md",
  "measurement_path": "tools/qualify/probe/testdata/opencode/measurement.json",
  "published_sample": "examples/WORKFLOW.agent-client-protocol.opencode.md",
  "tool_name_format": "{server}.{tool}",
  "project_config_paths": [
    "opencode.json",
    ".opencode",
    "AGENTS.md"
  ],
  "version_args": [
    "--version"
  ],
  "model_args": [],
  "model_env": {
    "name": "OPENCODE_CONFIG_CONTENT",
    "value": "{\"model\":\"{model}\"}",
    "asking_value": "{\"model\":\"{model}\",\"permission\":{\"*\":\"ask\"}}",
    "failing_value": "{\"model\":\"scripted/scripted-model\",\"provider\":{\"scripted\":{\"npm\":\"@ai-sdk/google\",\"name\":\"scripted\",\"options\":{\"baseURL\":\"{upstream}/v1beta\",\"apiKey\":\"sortie-stand-in\"},\"models\":{\"scripted-model\":{\"name\":\"scripted-model\"}}}}}"
  },
  "capability_gap_labels": [],
  "config_root_env_names": [
    "XDG_DATA_HOME",
    "OPENCODE_DB"
  ],
  "probe_prompts": {
    "success": "Reply with exactly SORTIE_BASELINE_OK and do not call any tool.",
    "runtime_refusal": "Decline to continue this turn and report your refusal outcome without calling a tool.",
    "tool_call": "Use your execute tool to run the code return await tools[\"sortie-probe-tools\"].{tool}() and then reply with exactly SORTIE_PROBE_DONE.",
    "continuation_seed": "Remember the phrase {nonce} for the rest of this conversation and reply exactly STORED.",
    "continuation_recall": "What phrase did I ask you to remember? Reply with that phrase only."
  },
  "entry_points": {
    "protocol": {
      "args": [
        "acp"
      ],
      "asking_args": [
        "acp"
      ]
    },
    "native_json": {
      "args": [
        "run",
        "--standalone",
        "--format",
        "default",
        "{prompt}"
      ]
    },
    "native_stream_json": {
      "resume_args": [
        "--session",
        "{session_id}"
      ],
      "args": [
        "run",
        "--standalone",
        "--auto",
        "--format",
        "json",
        "{prompt}"
      ],
      "asking_args": [
        "run",
        "--standalone",
        "--format",
        "json",
        "{prompt}"
      ]
    }
  },
  "recognizers": {
    "native_json": {
      "locator": {
        "mode": "first_value"
      },
      "error_members": [
        "error"
      ],
      "success_member": "response",
      "status_member": "",
      "status_cases": {},
      "status_end_turn": [],
      "model_request_path": []
    },
    "native_stream_json": {
      "locator": {
        "mode": "discriminated",
        "discriminator_key": "type",
        "discriminator_value": "text"
      },
      "error_members": [],
      "success_member": "part",
      "status_member": "",
      "status_cases": {},
      "status_end_turn": [],
      "model_request_path": [],
      "session_id_path": [
        "sessionID"
      ],
      "error_locator": {
        "mode": "discriminated",
        "discriminator_key": "type",
        "discriminator_value": "error"
      },
      "limit_locator": {
        "mode": "discriminated",
        "discriminator_path": [
          "error",
          "type"
        ],
        "discriminator_value": "output-limit"
      }
    }
  },
  "declarations": [
    {
      "capability": "turn_disposition",
      "case": "runtime_refusal",
      "reason": "outcome_never_produced"
    },
    {
      "capability": "retry_classification",
      "case": "non_retryable_refusal",
      "reason": "outcome_never_produced"
    },
    {
      "capability": "turn_disposition",
      "case": "limit_reached",
      "reason": "outcome_folded_into_another",
      "surface": "protocol"
    }
  ],
  "absent_surfaces": [
    {
      "surface": "native_json",
      "reason": "surface_not_offered"
    }
  ],
  "not_inducible_cases": [
    {
      "surface": "native_stream_json",
      "case": "cancellation",
      "reason": "terminal_written_at_exit_only"
    },
    {
      "surface": "native_stream_json",
      "case": "human_input",
      "reason": "terminal_vocabulary_closed"
    }
  ]
}
