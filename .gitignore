# Please do not use this ignore file to define platform specific files.
#
# For these purposes create a global .gitignore file, which is a list of rules
# for ignoring files in every Git repository on your workstation.
#
# https://help.github.com/articles/ignoring-files/#create-a-global-gitignore

# Test binary, built with `go test -c`.
*.test

# Manual tests
/WORKFLOW.test.md

# Code coverage profiles and other test artifacts.
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Application environment variables.
/.env
/.env.*

# Build artifacts
/sortie
/sortie.exe
/dist

.sortie.db
.sortie.db-shm
.sortie.db-wal

# Python cache files.
__pycache__
*.pyc

# Local environment variables for E2E tests.
env.local.sh
