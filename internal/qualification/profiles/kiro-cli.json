{
  "schema_version": 4,
  "runtime_id": "kiro-cli",
  "identity_tokens": ["kiro"],
  "notes_path": "docs/kiro-adapter-notes.md",
  "measurement_path": "internal/qualification/probe/testdata/kiro-cli/measurement.json",
  "published_sample": "examples/WORKFLOW.agent-client-protocol.kiro.md",
  "tool_name_format": "@{server}/{tool}",
  "project_config_paths": [
    ".kiro/settings/mcp.json",
    ".kiro/agents"
  ],
  "version_args": ["--version"],
  "model_args": ["--model", "{model}"],
  "capability_gap_labels": ["token counts"],
  "config_root_env_names": ["KIRO_HOME", "XDG_DATA_HOME"],
  "probe_prompts": {
    "success": "Reply with exactly SORTIE_BASELINE_OK and do not call any tool.",
    "runtime_refusal": "Decline to continue this turn and report your refusal outcome without calling a tool.",
    "tool_call": "Call the tool named {tool} now, with no arguments, then reply with exactly SORTIE_PROBE_DONE.",
    "continuation_seed": "Remember the phrase {nonce} for the rest of this conversation and reply exactly STORED.",
    "continuation_recall": "Reply with the phrase from earlier in this conversation and no other text."
  },
  "entry_points": {
    "protocol": {
      "args": ["acp", "--model", "{model}", "-a"],
      "asking_args": ["acp", "--model", "{model}"]
    },
    "native_json": {
      "args": ["chat", "--model", "{model}", "--no-interactive", "--trust-tools=", "{prompt}"]
    },
    "native_stream_json": {
      "resume_args": ["--resume-id", "{session_id}"],
      "args": ["chat", "--agent-engine", "v2", "--model", "{model}", "--no-interactive", "--trust-all-tools", "--output-format", "stream-json", "{prompt}"],
      "asking_args": ["chat", "--agent-engine", "v2", "--model", "{model}", "--no-interactive", "--trust-tools=", "--output-format", "stream-json", "{prompt}"]
    }
  },
  "recognizers": {
    "native_json": {
      "locator": {"mode": "first_value"},
      "error_members": ["error"],
      "success_member": "response",
      "status_member": "",
      "status_cases": {},
      "status_end_turn": [],
      "model_request_path": []
    },
    "native_stream_json": {
      "locator": {
        "mode": "discriminated",
        "discriminator_key": "type",
        "discriminator_value": "runFinished",
        "envelope_path": ["data"]
      },
      "error_members": [],
      "success_member": "",
      "status_member": "status",
      "status_cases": {},
      "status_end_turn": ["success"],
      "model_request_path": [],
      "session_id_path": ["sessionId"]
    }
  },
  "declarations": [
    {"capability": "turn_disposition", "case": "runtime_refusal", "reason": "outcome_never_produced"},
    {"capability": "retry_classification", "case": "non_retryable_refusal", "reason": "outcome_never_produced"}
  ],
  "absent_surfaces": [
    {"surface": "native_json", "reason": "surface_not_offered"}
  ],
  "not_inducible_cases": [
    {"surface": "protocol", "case": "limit_reached", "reason": "prompt_channel_too_small"},
    {"surface": "native_stream_json", "case": "limit_reached", "reason": "prompt_channel_too_small"},
    {"surface": "native_stream_json", "case": "runtime_failure", "reason": "output_channel_silent_on_failure"},
    {"surface": "native_stream_json", "case": "cancellation", "reason": "terminal_written_at_exit_only"}
  ]
}
